new file mode 100644
index 0000000..8ff1216
--- /dev/null
+++ b/server/tests/bridge_route.rs
@@ -0,0 +1,266 @@
+//! Verifies that a dedicated bridge never hands a Cursor Run to Cursor's own
+//! backend. Cursor names the Run model from the catalogue it last read, so it
+//! can ask for its own Auto (`default`) or for a hash a replaced catalogue no
+//! longer contains; an account without Agent quota answers such a Run with
+//! `ResourceExhausted`, which the editor shows as "You've hit your usage limit".
+#[path = "support/fake_provider.rs"]
+mod fake_provider;
+#[path = "support/fixtures.rs"]
+mod fixtures;
+
+use std::{path::Path, sync::Arc, time::Duration};
+
+use axum::{
+    body::Body,
+    http::{header, Request, StatusCode},
+};
+use cursor_server::{
+    api::cursor::{self, bidi::BridgeRoute},
+    cursor::{
+        prompting::{PromptAssets, PromptCompiler},
+        protocol::{
+            connect,
+            proto::{agent::v1 as pb, aiserver::v1 as ai},
+        },
+        transport::TransportRegistry,
+        TransportCommand, TransportHandle,
+    },
+    model::{ModelConfigInput, ModelType, ModelRequest, OPENAI_CHAT_ENDPOINT},
+    network::NetworkClients,
+    provider::{FinishReason, ModelEvent},
+};
+use prost::Message;
+use tower::ServiceExt;
+
+fn model_input(openai_model: &str) -> ModelConfigInput {
+    ModelConfigInput {
+        sort_order: 1,
+        display_name: format!("{openai_model} · Magpie"),
+        group_name: None,
+        model_type: ModelType::OpenAi,
+        base_url: "http://127.0.0.1:3425/v1".into(),
+        use_full_url: false,
+        api_key: "magpie-cursor-bridge".into(),
+        tooltip_data: format!("Magpie / {openai_model}"),
+        model_id: openai_model.into(),
+        reasoning_effort: None,
+        openai_endpoint: OPENAI_CHAT_ENDPOINT.into(),
+        openai_extra_params_enabled: false,
+        openai_extra_params: serde_json::json!({}),
+        custom_headers_enabled: false,
+        custom_headers: serde_json::json!({}),
+        anthropic_extra_params_enabled: false,
+        anthropic_extra_params: serde_json::json!({}),
+        context_window_tokens: None,
+        max_completion_tokens: None,
+        anthropic_max_tokens: None,
+        anthropic_thinking_effort: None,
+        thinking_budget_tokens: None,
+    }
+}
+
+fn user_turn(model_id: &str) -> pb::AgentClientMessage {
+    pb::AgentClientMessage {
+        message: Some(pb::agent_client_message::Message::RunRequest(
+            pb::AgentRunRequest {
+                action: Some(pb::ConversationAction {
+                    action: Some(pb::conversation_action::Action::UserMessageAction(
+                        pb::UserMessageAction {
+                            user_message: Some(pb::UserMessage {
+                                text: "hello".into(),
+                                message_id: "bridge-user".into(),
+                                mode: pb::AgentMode::Agent as i32,
+                                ..Default::default()
+                            }),
+                            ..Default::default()
+                        },
+                    )),
+                    ..Default::default()
+                }),
+                conversation_id: Some("bridge-conversation".into()),
+                run_id: Some("bridge-run".into()),
+                requested_model: Some(pb::RequestedModel {
+                    model_id: model_id.into(),
+                    ..Default::default()
+                }),
+                model_details: Some(pb::ModelDetails {
+                    model_id: model_id.into(),
+                    ..Default::default()
+                }),
+                ..Default::default()
+            },
+        )),
+    }
+}
+
+fn append(request_id: &str, message: &pb::AgentClientMessage) -> Vec<u8> {
+    ai::BidiAppendRequest {
+        request_id: Some(ai::BidiRequestId {
+            request_id: request_id.into(),
+        }),
+        data_binary: message.encode_to_vec(),
+        ..Default::default()
+    }
+    .encode_to_vec()
+}
+
+fn kv_ack(id: u32) -> pb::AgentClientMessage {
+    pb::AgentClientMessage {
+        message: Some(pb::agent_client_message::Message::KvClientMessage(
+            pb::KvClientMessage {
+                id,
+                message: Some(pb::kv_client_message::Message::SetBlobResult(
+                    pb::SetBlobResult { error: None },
+                )),
+            },
+        )),
+    }
+}
+
+fn stop_response(model_call_id: &str, text: &str) -> Vec<ModelEvent> {
+    vec![
+        ModelEvent::Start {
+            model_call_id: model_call_id.into(),
+        },
+        ModelEvent::TextStart,
+        ModelEvent::TextDelta(text.into()),
+        ModelEvent::TextEnd,
+        ModelEvent::Done(FinishReason::Stop),
+    ]
+}
+
+/// Answer the client interactions a Run needs until the model is called; a
+/// bridge serves every Run locally, so reaching the provider is the assertion.
+async fn model_requests(
+    handle: &TransportHandle,
+    provider: &fake_provider::FakeProvider,
+) -> Vec<ModelRequest> {
+    let mut output = handle.subscribe();
+    let mut seqno = 1;
+    tokio::time::timeout(Duration::from_secs(10), async {
+        while provider.requests().is_empty() {
+            let Ok(Some(frame)) =
+                tokio::time::timeout(Duration::from_millis(50), output.recv()).await
+            else {
+                continue;
+            };
+            let (flags, payload) = connect::decode_frames(&frame).unwrap().pop().unwrap();
+            if flags & connect::END_STREAM_FLAG != 0 {
+                panic!("Run ended before the model was called");
+            }
+            let server = pb::AgentServerMessage::decode(payload).unwrap();
+            let reply = match server.message {
+                Some(pb::agent_server_message::Message::KvServerMessage(kv)) => Some(kv_ack(kv.id)),
+                Some(pb::agent_server_message::Message::ExecServerMessage(exec)) => {
+                    Some(pb::AgentClientMessage {
+                        message: Some(
+                            pb::agent_client_message::Message::ExecClientControlMessage(
+                                pb::ExecClientControlMessage {
+                                    message: Some(
+                                        pb::exec_client_control_message::Message::StreamClose(
+                                            pb::ExecClientStreamClose { id: exec.id },
+                                        ),
+                                    ),
+                                },
+                            ),
+                        ),
+                    })
+                }
+                _ => None,
+            };
+            if let Some(reply) = reply {
+                handle
+                    .command(TransportCommand::Append {
+                        seqno,
+                        message: Box::new(reply),
+                    })
+                    .await
+                    .unwrap();
+                seqno += 1;
+            }
+        }
+    })
+    .await
+    .expect("the model must be called");
+    provider.requests()
+}
+
+/// Cursor's Auto travels as `default`, which names no Magpie route: the bridge
+/// must run it on the route Magpie selected instead of forwarding it upstream.
+#[tokio::test]
+async fn cursor_auto_runs_on_the_magpie_route() {
+    let (_directory, store) = fixtures::temp_store().await;
+    let other = store.create_model(&model_input("p/a")).await.unwrap();
+    let selected = store.create_model(&model_input("p/b")).await.unwrap();
+    let provider = fake_provider::FakeProvider::default();
+    provider.push(stop_response("auto-call", "hi"));
+    let assets =
+        PromptAssets::load(Path::new(env!("CARGO_MANIFEST_DIR")).join("prompt/cursor").as_path())
+            .unwrap();
+    let registry = TransportRegistry::new(
+        store.clone(),
+        Arc::new(provider.clone()),
+        PromptCompiler::new(assets),
+    );
+    let router = cursor::router(registry.clone(), NetworkClients::new(store))
+        .unwrap()
+        .layer(axum::Extension(BridgeRoute::new("p/b")));
+
+    let response = router
+        .oneshot(
+            Request::post("/aiserver.v1.BidiService/BidiAppend")
+                .header(header::CONTENT_TYPE, "application/proto")
+                .body(Body::from(append("auto-request", &user_turn("default"))))
+                .unwrap(),
+        )
+        .await
+        .unwrap();
+
+    assert_eq!(response.status(), StatusCode::OK);
+    assert!(
+        !registry.upstream("auto-request").await,
+        "a bridge must never forward a Run to Cursor's backend"
+    );
+    let handle = registry.local("auto-request").await.expect("local transport");
+    let requests = model_requests(&handle, &provider).await;
+    assert_eq!(requests.len(), 1);
+    assert_eq!(requests[0].model.model_id, selected.model_hash);
+    assert_ne!(requests[0].model.model_id, other.model_hash);
+}
+
+/// A catalogue route Cursor names stays exactly as the client selected it.
+#[tokio::test]
+async fn a_route_the_catalogue_serves_is_left_alone() {
+    let (_directory, store) = fixtures::temp_store().await;
+    let other = store.create_model(&model_input("p/a")).await.unwrap();
+    let selected = store.create_model(&model_input("p/b")).await.unwrap();
+    let provider = fake_provider::FakeProvider::default();
+    provider.push(stop_response("hash-call", "hi"));
+    let assets =
+        PromptAssets::load(Path::new(env!("CARGO_MANIFEST_DIR")).join("prompt/cursor").as_path())
+            .unwrap();
+    let registry = TransportRegistry::new(
+        store.clone(),
+        Arc::new(provider.clone()),
+        PromptCompiler::new(assets),
+    );
+    let router = cursor::router(registry.clone(), NetworkClients::new(store))
+        .unwrap()
+        .layer(axum::Extension(BridgeRoute::new("p/b")));
+
+    let response = router
+        .oneshot(
+            Request::post("/aiserver.v1.BidiService/BidiAppend")
+                .header(header::CONTENT_TYPE, "application/proto")
+                .body(Body::from(append("hash-request", &user_turn(&other.model_hash))))
+                .unwrap(),
+        )
+        .await
+        .unwrap();
+
+    assert_eq!(response.status(), StatusCode::OK);
+    let handle = registry.local("hash-request").await.expect("local transport");
+    let requests = model_requests(&handle, &provider).await;
+    assert_eq!(requests[0].model.model_id, other.model_hash);
+    assert_ne!(requests[0].model.model_id, selected.model_hash);
+}
