+        assert_eq!(parent.tool_call_id, None);
+        headers.remove("x-parent-request-id");
+        headers.insert("x-parent-agent-tool-call-id", HeaderValue::from_static("tool"));
+        let parent = parent_headers(&headers).unwrap().unwrap();
+        assert_eq!(parent.request_id, None);
+        assert_eq!(parent.tool_call_id.as_deref(), Some("tool"));
+        headers.insert("x-parent-request-id", HeaderValue::from_static("request"));
+        let parent = parent_headers(&headers).unwrap().unwrap();
+        assert_eq!(parent.request_id.as_deref(), Some("request"));
+        assert_eq!(parent.tool_call_id.as_deref(), Some("tool"));
