diff --git a/server/tests/bridge_bidi_wire.rs b/server/tests/bridge_bidi_wire.rs
new file mode 100644
index 0000000..4a9734b
--- /dev/null
+++ b/server/tests/bridge_bidi_wire.rs
@@ -0,0 +1,60 @@
+use cursor_server::{api::cursor::bidi, cursor::protocol::proto::{agent::v1 as pb, aiserver::v1 as ai}};
+use prost::Message;
+
+fn request(payload: &[u8], binary: bool) -> ai::BidiAppendRequest {
+    ai::BidiAppendRequest {
+        request_id: Some(ai::BidiRequestId { request_id: "wire-regression".into() }),
+        data: if binary { String::new() } else { hex::encode(payload) },
+        data_binary: if binary { payload.to_vec() } else { vec![] },
+        ..Default::default()
+    }
+}
+
+#[test]
+fn bridge_bidi_hex_and_binary_preserve_state_blob_references() {
+    // Blob references are opaque bytes, not nested protobuf messages.
+    let state = pb::ConversationStateStructure {
+        root_prompt_messages_json: vec![vec![0x06, 0xff, 0x00]],
+        turns: vec![vec![0x06, 0xff]],
+        todos: vec![vec![0xff]],
+        summary: Some(vec![0x06]),
+        ..Default::default()
+    };
+    let message = pb::AgentClientMessage {
+        message: Some(pb::agent_client_message::Message::RunRequest(pb::AgentRunRequest {
+            conversation_state: Some(state),
+            conversation_id: Some("synthetic".into()),
+            ..Default::default()
+        })),
+    };
+    let bytes = message.encode_to_vec();
+    for binary in [false, true] {
+        let decoded = bidi::decode(&request(&bytes, binary)).unwrap();
+        assert_eq!(decoded.message, message);
+        assert_eq!(decoded.seqno, 0);
+    }
+}
+
+#[test]
+fn bridge_bidi_rejects_ambiguous_and_empty_envelopes() {
+    let mut value = request(&[0x3a, 0], true);
+    value.data = "3a00".into();
+    assert!(bidi::decode(&value).unwrap_err_string().contains("both data and data_binary"));
+    assert!(bidi::decode(&request(&[], false)).is_err());
+}
+
+trait ErrorString { fn unwrap_err_string(self) -> String; }
+impl ErrorString for cursor_server::Result<bidi::DecodedAppend> {
+    fn unwrap_err_string(self) -> String { match self { Err(e) => e.to_string(), Ok(_) => panic!("expected error") } }
+}
+
+#[test]
+fn bridge_bidi_invalid_state_reproduces_cursor_error_without_tls() {
+    // AgentClientMessage.run_request -> conversation_state -> illegal wire type 6.
+    let bytes = [0x0a, 0x03, 0x0a, 0x01, 0x06];
+    for binary in [false, true] {
+        let error = bidi::decode(&request(&bytes, binary)).unwrap_err_string();
+        assert!(error.contains("AgentRunRequest.conversation_state") && error.contains("d2@0:invalid-key"), "{error}");
+        assert!(error.contains("invalid wire type value: 6"), "{error}");
+    }
+}
