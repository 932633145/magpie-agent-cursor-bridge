+    // Cursor's Git actions only reach Magpie when the commit row names a stored
+    // model, and the row it needs is the hash, not the route id.
+    #[tokio::test]
+    async fn git_actions_generate_through_the_selected_route() {
+        let dir=tempfile::tempdir().unwrap();
+        let store=Store::connect(&format!("sqlite://{}",dir.path().join("commit.db").display())).await.unwrap();
+        let first=catalogue(&serde_json::to_vec(&config()).unwrap()).unwrap();
