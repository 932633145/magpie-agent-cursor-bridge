+fn clean_branch_name(value: &str) -> Option<String> {
+    let fenced = strip_code_fence(value);
+    let line = fenced.lines().map(str::trim).find(|line| !line.is_empty())?;
+    let mut name = String::new();
+    for character in line.chars() {
+        if character.is_alphanumeric() {
+            name.extend(character.to_lowercase());
+        } else if character == '-' || character == '/' || character == '.' {
+            name.push(character);
+        } else if character.is_whitespace() || character == '_' {
+            name.push('-');
+        }
+    }
+    let name = trim_branch_name(&name);
+    (!name.is_empty()).then_some(name)
+}
+
+/// Git refuses `..`, `//`, and leading or trailing separators, and the model's
+/// line can produce any of them (a scope in parentheses, a sentence's full
+/// stop, "feat: Add"). Collapse and trim them instead of refusing the name.
+fn trim_branch_name(name: &str) -> String {
+    let mut collapsed = String::new();
+    for character in name.chars() {
+        let separator = character == '-' || character == '/' || character == '.';
+        if separator && collapsed.chars().next_back() == Some(character) {
+            continue;
+        }
+        collapsed.push(character);
+    }
+    let trim = |value: &str| {
+        value
+            .trim_matches(|character| character == '-' || character == '/' || character == '.')
+            .to_owned()
+    };
+    let trimmed = trim(&collapsed);
+    let capped: String = trimmed.chars().take(BRANCH_MAX_LENGTH).collect();
+    trim(&capped)
+}
