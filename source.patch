+// Inspect only protobuf keys/lengths. Never interpret arbitrary byte fields as messages.
+fn wire_structure(payload: &[u8]) -> String {
+    fn scan(bytes: &[u8], depth: usize, budget: &mut usize, out: &mut String) {
+        use prost::encoding::{decode_key, decode_varint, skip_field, DecodeContext, WireType};
+        use std::fmt::Write;
+        let mut rest = bytes;
+        while !rest.is_empty() && *budget > 0 {
+            *budget -= 1;
+            let offset = bytes.len() - rest.len();
+            let Ok((tag, wire)) = decode_key(&mut rest) else {
+                let _ = write!(out, " d{depth}@{offset}:invalid-key");
+                return;
+            };
+            let _ = write!(out, " d{depth}@{offset}:f{tag}/{wire:?}");
+            if wire == WireType::LengthDelimited {
+                let Ok(length) = decode_varint(&mut rest) else {
+                    out.push_str(":invalid-length");
+                    return;
+                };
+                let _ = write!(out, ":len{length}");
+                if length > rest.len() as u64 {
+                    out.push_str(":truncated");
+                    return;
+                }
+                let (value, tail) = rest.split_at(length as usize);
+                // AgentClientMessage.run_request -> AgentRunRequest.conversation_state.
+                if depth < 2 && tag == 1 { scan(value, depth + 1, budget, out); }
+                rest = tail;
+            } else if skip_field(wire, tag, &mut rest, DecodeContext::default()).is_err() {
+                out.push_str(":invalid-value");
+                return;
+            }
+        }
+        if *budget == 0 { out.push_str(":limit"); }
+    }
+    let mut out = format!("bytes={}", payload.len());
+    scan(payload, 0, &mut 48, &mut out);
+    out
+}
