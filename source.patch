+/// Route policy of a dedicated Magpie bridge.
+///
+/// Cursor names the model of a Run from the catalogue it last read, so a Run
+/// can ask for something the bridge does not serve: Cursor's own Auto, which
+/// travels as `default`, or a hash whose catalogue entry Magpie has since
+/// dropped. A bridge has no Cursor account, so forwarding such a Run upstream
+/// can only fail — Cursor answers `ResourceExhausted` once the signed-in
+/// account's own quota is spent, which the editor reports as "You've hit your
+/// usage limit". The bridge therefore serves those Runs with the route Magpie
+/// selected. The route is kept as Magpie's model id rather than a catalogue
+/// hash so it stays valid across catalogue replacements.
+#[derive(Clone, Default)]
+pub struct BridgeRoute {
+    selected: Arc<RwLock<Option<String>>>,
+}
+
+impl BridgeRoute {
+    pub fn new(selected: impl Into<String>) -> Self {
+        Self {
+            selected: Arc::new(RwLock::new(Some(selected.into()))),
+        }
+    }
+
+    pub fn selected(&self) -> Option<String> {
+        self.selected.read().clone()
+    }
+
+    pub fn set(&self, selected: impl Into<String>) {
+        *self.selected.write() = Some(selected.into());
+    }
+}
