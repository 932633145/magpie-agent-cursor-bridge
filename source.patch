diff --git a/server/src/bin/cursor-magpie-bridge.rs b/server/src/bin/cursor-magpie-bridge.rs
new file mode 100644
index 0000000..1c22c83
--- /dev/null
+++ b/server/src/bin/cursor-magpie-bridge.rs
@@ -0,0 +1,225 @@
+//! Headless Cursor protocol bridge. No desktop/account writes or management API.
+use std::{path::PathBuf, sync::Arc, time::Duration};
+use cursor_server::{api, config, cursor::{prompting::{PromptAssets, PromptCompiler}, transport::TransportRegistry}, local_app::CursorHarness, model::ModelConfigInput, network::NetworkClients, plugin::{PluginRegistry, PluginRuntime}, provider::ProviderRouter, search::WebCache, store::Store};
+use serde::Deserialize;
+use serde_json::json;
+use tokio_util::sync::CancellationToken;
+
+#[derive(Deserialize)]
+struct Connection { gateway: String, key: String, model: String, models: Vec<BridgeModel> }
+#[derive(Deserialize)]
+struct BridgeModel { id: String, #[serde(default)] name: String, context: Option<u64> }
+
+/// The catalogue and the route Magpie has selected, which is also what Cursor's
+/// Git actions generate through.
+struct Catalogue { selected: String, models: Vec<ModelConfigInput> }
+
+// Cursor asks for commit messages only as diffs; the language has to follow the
+// diff itself, which neither built-in locale prompt does.
+const AUTO_COMMIT_PROMPT: &str = include_str!("../../prompt/cursor/commit/auto.md");
+
+fn catalogue(bytes: &[u8]) -> Result<Catalogue, Box<dyn std::error::Error>> {
+    let c: Connection = serde_json::from_slice(bytes)?;
+    let url = url::Url::parse(&c.gateway)?;
+    if url.scheme() != "http" || !matches!(url.host_str(), Some("127.0.0.1" | "localhost" | "[::1]")) || !url.username().is_empty() || url.password().is_some() || url.query().is_some() || url.fragment().is_some() {
+        return Err("only a loopback Magpie gateway is supported".into());
+    }
+    if c.key.trim().is_empty() || !c.models.iter().any(|m| m.id == c.model) { return Err("missing gateway key or selected model".into()); }
+    let selected = c.model;
+    let mut models = c.models;
+    models.sort_by_key(|m| m.id != selected);
+    let mut seen = std::collections::HashSet::new();
+    let models = models.into_iter().enumerate().map(|(i,m)| {
+        if !seen.insert(m.id.clone()) { return Err("duplicate model id".into()); }
+        Ok(serde_json::from_value(json!({
+            "sort_order": i, "display_name": if m.name.is_empty() {m.id.clone()} else {format!("{} · {}", m.name, m.id)},
+            "group_name":"Magpie", "type":"openai", "base_url": c.gateway.trim_end_matches('/'),
+            "api_key":c.key, "tooltip_data":format!("Magpie / {}",m.id), "model_id":m.id,
+            "context_window_tokens":m.context.filter(|v| *v > 0),
+            "custom_headers_enabled":true, "custom_headers":{"User-Agent":"cursor-magpie-bridge/0.2.1"}
+        }))?)
+    }).collect::<Result<Vec<ModelConfigInput>, Box<dyn std::error::Error>>>()?;
+    Ok(Catalogue { selected, models })
+}
+
+/// Cursor's SCM actions (commit message, branch name) generate through
+/// `commit_settings.model_id`, which is the row hash the provider resolves. It
+/// stays empty until something sets it, and an empty value means "forward to
+/// Cursor upstream", which fails here: the bridge has no Cursor account. Pin it
+/// to the route Magpie selected, and keep a prompt a user already wrote.
+async fn apply_commit_model(store: &Store, selected: &str) -> Result<(), Box<dyn std::error::Error>> {
+    let hash = store.models().await?
+        .into_iter()
+        .find(|model| model.model_id == selected)
+        .ok_or("selected model is missing from the bridge catalogue")?
+        .model_hash;
+    let mut settings = store.commit_settings().await?;
+    let prompt = if settings.prompt.trim().is_empty() { AUTO_COMMIT_PROMPT.trim().to_owned() } else { settings.prompt.clone() };
+    if settings.model_id == hash && settings.prompt == prompt { return Ok(()); }
+    settings.model_id = hash;
+    settings.prompt = prompt;
+    store.set_commit_settings(settings).await?;
+    Ok(())
+}
+
+#[tokio::main]
+async fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let argument = std::env::args().nth(1);
+    if argument.as_deref() == Some("--version") {
+        println!("0.2.1");
+        return Ok(());
+    }
+    if argument.as_deref() == Some("--help") || argument.is_none() {
+        println!("cursor-magpie-bridge 0.2.1\nUsage: cursor-magpie-bridge --init-ca | CONNECTION.json\nRequires CURSOR_BYOK_DATA_DIR (absolute path). --init-ca never modifies certificate trust.");
+        return Ok(());
+    }
+    // A dedicated directory is mandatory: never open the desktop BYOK database.
+    if std::env::var_os("CURSOR_BYOK_DATA_DIR").is_none() { return Err("CURSOR_BYOK_DATA_DIR is required".into()); }
+    if argument.as_deref() == Some("--init-ca") {
+        let state = cursor_server::local_app::initialize_bridge_ca()?;
+        println!("{}", json!({"ca":state, "certificate":config::managed_data_dir()?.join("ca/ca.crt")}));
+        return Ok(());
+    }
+    let path = PathBuf::from(argument.unwrap());
+    let mut contents = tokio::fs::read(&path).await?;
+    let mut current = catalogue(&contents)?;
+    let root = config::managed_data_dir()?;
+    let store = Store::connect(&format!("sqlite://{}",root.join("bridge.db").display())).await?;
+    store.replace_bridge_models(&current.models).await?;
+    apply_commit_model(&store, &current.selected).await?;
+    // 桥接没有 Cursor 账号:Cursor 自己选的 Auto(`default`)或目录里已消失的
+    // 哈希都必须落到 Magpie 选中的路由上,不能转发到官方上游。
+    let route = cursor_server::api::cursor::bidi::BridgeRoute::new(current.selected.clone());
+    let plugins = PluginRegistry::managed(store.clone(), PluginRuntime::managed()?, "1.0.1".into())?;
+    let clients = NetworkClients::bridge(store.clone());
+    let provider = Arc::new(ProviderRouter::new(store.clone(),plugins.clone(),clients.clone(),Duration::from_secs(3600),Duration::from_secs(1800)));
+    let registry = TransportRegistry::with_plugins(store.clone(),provider,PromptCompiler::new(PromptAssets::embedded()?),WebCache::managed()?,plugins,root.join("rules"));
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await?;
+    let address = listener.local_addr()?;
+    registry.web_cache().set_service_addr(address);
+    let router = api::router(registry.clone(),clients)?
+        .layer(axum::Extension(cursor_server::cursor::services::model_catalog::LocalCatalogOnly))
+        .layer(axum::Extension(route.clone()));
+    let harness = CursorHarness::new(store.clone())?;
+    harness.set_backend_addr(address);
+    let proxy = harness.start_proxy_only().await?;
+    let shutdown = CancellationToken::new();
+    let cancel = shutdown.clone();
+    let server = tokio::spawn(async move { axum::serve(listener,router).with_graceful_shutdown(async move {cancel.cancelled().await}).await });
+    println!("{}",json!({"event":"ready","proxy":proxy,"backend":format!("http://{address}"),"models":current.models.len()}));
+    // The supervisor owns stdin. Its death must not leave an orphan TLS proxy.
+    let parent_closed = CancellationToken::new();
+    let parent_signal = parent_closed.clone();
+    std::thread::spawn(move || {
+        use std::io::Read;
+        let mut buf = [0u8; 64];
+        while matches!(std::io::stdin().read(&mut buf), Ok(n) if n > 0) {}
+        parent_signal.cancel();
+    });
+    let mut interval = tokio::time::interval(Duration::from_secs(2));
+    #[cfg(unix)]
+    let mut sigterm = tokio::signal::unix::signal(tokio::signal::unix::SignalKind::terminate())?;
+    let terminate = async {
+        #[cfg(unix)]
+        sigterm.recv().await;
+        #[cfg(not(unix))]
+        std::future::pending::<()>().await;
+    };
+    tokio::pin!(terminate);
+    loop {
+        tokio::select! {
+            _ = tokio::signal::ctrl_c() => break,
+            _ = &mut terminate => break,
+            _ = parent_closed.cancelled() => break,
+            _ = interval.tick() => {
+                if server.is_finished() { break; }
+                match tokio::fs::read(&path).await {
+                    Ok(next) if next != contents => match catalogue(&next) {
+                        Ok(catalogue) => {
+                            if store.replace_bridge_models(&catalogue.models).await.is_ok() {
+                                // Cursor's own model selection follows Magpie.
+                                route.set(catalogue.selected.clone());
+                                // A route switched in Magpie must move the Git
+                                // actions with it; the models are already live,
+                                // so this failing only leaves them on the old one.
+                                if let Err(error) = apply_commit_model(&store, &catalogue.selected).await {
+                                    eprintln!("commit model not updated: {error}");
+                                }
+                                contents = next;
+                                current = catalogue;
+                                println!("{}",json!({"event":"catalogue","models":current.models.len()}));
+                            } else { eprintln!("catalogue update failed; retaining last complete catalogue"); }
+                        }
+                        Err(_) => eprintln!("invalid catalogue; retaining last complete catalogue"),
+                    },
+                    _ => {},
+                }
+            }
+        }
+    }
+    harness.stop_proxy_only().await;
+    registry.shutdown().await;
+    shutdown.cancel();
+    let _ = tokio::time::timeout(Duration::from_secs(10),server).await;
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use cursor_server::store::CommitSettings;
+    fn config() -> serde_json::Value { json!({"gateway":"http://127.0.0.1:3425/v1","key":"test-only","model":"p/b","models":[{"id":"p/a","name":"A","context":200000},{"id":"p/b","name":"B"}]}) }
+    #[test]
+    fn selected_model_first_and_route_preserved() {
+        let catalogue=catalogue(&serde_json::to_vec(&config()).unwrap()).unwrap();
+        assert_eq!(catalogue.selected,"p/b");
